<% layout('layout/boilerplate') %>
<div class="container">

    <!-- HERO SECTION -->
    <div class="jumbotron mt-4 text-white"
        style="background: linear-gradient(rgba(0,0,0,.5), rgba(0,0,0,.5)), url('https://images.unsplash.com/photo-1478131143081-80f7f84ca84d?auto=format&fit=crop&w=1600&q=80'); background-size: cover; background-position: center; border-radius: 12px; padding: 100px 40px;">

        <h1 class="display-3 font-weight-bold">
            Welcome to YelpCamp!
        </h1>

        <p class="lead mt-4">
            Discover amazing campgrounds, explore beautiful places
            and share your outdoor adventures with the world.
        </p>

        <hr class="my-4 bg-light">

        <p>
            Your next adventure is just one click away.
        </p>

        <a class="btn btn-warning btn-lg font-weight-bold"
            href="/campgrounds">
            Explore Campgrounds
        </a>
    </div>


    <!-- INTRODUCTION -->
    <div class="row justify-content-center text-center my-5">
        <div class="col-md-8">
            <h2 class="font-weight-bold">Explore the Outdoors</h2>
            <p class="text-muted mt-3">
                From peaceful forests to breathtaking mountain views,
                find the perfect place to escape your everyday routine.
                Discover, explore and create unforgettable memories.
            </p>
        </div>
    </div>


    <!-- FEATURES -->
    <div class="row mb-5">

        <div class="col-md-4 mb-4">
            <div class="card h-100 shadow-sm border-0">
                <img
                    src="https://images.unsplash.com/photo-1478131143081-80f7f84ca84d?auto=format&fit=crop&w=800&q=80"
                    class="card-img-top"
                    alt="Camping in nature"
                    style="height: 220px; object-fit: cover;">

                <div class="card-body text-center">
                    <h4 class="card-title font-weight-bold">
                        Discover Places
                    </h4>
                    <p class="card-text text-muted">
                        Find beautiful campgrounds and explore
                        destinations you've never visited before.
                    </p>
                </div>
            </div>
        </div>


        <div class="col-md-4 mb-4">
            <div class="card h-100 shadow-sm border-0">
                <img
                    src="https://images.unsplash.com/photo-1504851149312-7a075b496cc7?auto=format&fit=crop&w=800&q=80"
                    class="card-img-top"
                    alt="Mountain camping"
                    style="height: 220px; object-fit: cover;">

                <div class="card-body text-center">
                    <h4 class="card-title font-weight-bold">
                        Share Experiences
                    </h4>
                    <p class="card-text text-muted">
                        Share your favourite camping spots
                        and inspire fellow outdoor enthusiasts.
                    </p>
                </div>
            </div>
        </div>


        <div class="col-md-4 mb-4">
            <div class="card h-100 shadow-sm border-0">
                <img
                    src="https://images.unsplash.com/photo-1473448912268-2022ce9509d8?auto=format&fit=crop&w=800&q=80"
                    class="card-img-top"
                    alt="Forest landscape"
                    style="height: 220px; object-fit: cover;">

                <div class="card-body text-center">
                    <h4 class="card-title font-weight-bold">
                        Read Reviews
                    </h4>
                    <p class="card-text text-muted">
                        Read reviews from other campers
                        before planning your next adventure.
                    </p>
                </div>
            </div>
        </div>

    </div>


    <!-- CALL TO ACTION -->
    <div class="bg-dark text-white text-center p-5 mb-5"
        style="border-radius: 12px;">

        <h2 class="font-weight-bold">
            The Adventure Begins Here!
        </h2>

        <p class="lead text-light mt-3">
            Pack your bags, find your destination and get ready
            to experience something extraordinary.
        </p>

        <a href="/campgrounds"
            class="btn btn-warning btn-lg mt-3 font-weight-bold">
            Start Exploring
        </a>

    </div>

</div>
```