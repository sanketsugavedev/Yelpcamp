<% layout('layout/boilerplate') %>

<div class="container py-5">

    <div class="row justify-content-center">
        <div class="col-lg-8 col-md-10">

            <!-- PAGE HEADER -->
            <div class="text-center mb-4">
                <h1 class="font-weight-bold">Edit Campground</h1>
                <p class="text-muted">
                    Update your campground details and manage its photos.
                </p>
            </div>

            <!-- EDIT FORM CARD -->
            <div class="card shadow-sm border-0">

                <div class="card-header bg-dark text-white py-3">
                    <h5 class="mb-0">Campground Information</h5>
                </div>

                <div class="card-body p-4">

                    <form
                        enctype="multipart/form-data"
                        action="/campgrounds/<%= campground._id %>?_method=PUT"
                        method="POST"
                        novalidate
                        class="validated-form">

                        <!-- TITLE -->
                        <div class="form-group">
                            <label for="title" class="font-weight-bold">
                                Campground Name
                            </label>

                            <input
                                class="form-control"
                                type="text"
                                id="title"
                                name="campground[title]"
                                value="<%= campground.title %>"
                                placeholder="Enter campground name"
                                required>

                            <div class="invalid-feedback">
                                Please enter a campground name.
                            </div>
                        </div>


                        <!-- LOCATION -->
                        <div class="form-group">
                            <label for="location" class="font-weight-bold">
                                Location
                            </label>

                            <input
                                class="form-control"
                                type="text"
                                name="campground[location]"
                                id="location"
                                value="<%= campground.location %>"
                                placeholder="Enter campground location"
                                required>

                            <div class="invalid-feedback">
                                Please enter a location.
                            </div>
                        </div>


                        <!-- PRICE -->
                        <div class="form-group">
                            <label for="price" class="font-weight-bold">
                                Campground Price
                            </label>

                            <div class="input-group">
                                <div class="input-group-prepend">
                                    <span class="input-group-text">$</span>
                                </div>

                                <input
                                    type="number"
                                    class="form-control"
                                    id="price"
                                    placeholder="0.00"
                                    name="campground[price]"
                                    value="<%= campground.price %>"
                                    min="0"
                                    required>
                            </div>

                            <small class="form-text text-muted">
                                Enter the price per night.
                            </small>
                        </div>


                        <!-- DESCRIPTION -->
                        <div class="form-group">
                            <label for="description" class="font-weight-bold">
                                Description
                            </label>

                            <textarea
                                class="form-control"
                                name="campground[description]"
                                id="description"
                                rows="5"
                                placeholder="Describe your campground..."
                                required><%= campground.description %></textarea>

                            <div class="invalid-feedback">
                                Please enter a description.
                            </div>
                        </div>


                        <hr class="my-4">


                        <!-- IMAGE UPLOAD -->
                        <h5 class="font-weight-bold mb-3">
                            <i class="fas fa-images mr-2"></i>
                            Upload New Images
                        </h5>

                        <div class="custom-file mb-3">
                            <input
                                type="file"
                                class="custom-file-input"
                                id="inputGroupFile02"
                                name="image"
                                multiple>

                            <label
                                class="custom-file-label"
                                for="inputGroupFile02">
                                Choose campground images
                            </label>
                        </div>

                        <small class="text-muted d-block mb-4">
                            You can select multiple images at once.
                        </small>


                        <!-- EXISTING IMAGES -->
                        <% if (campground.images && campground.images.length > 0) { %>

                            <hr class="my-4">

                            <h5 class="font-weight-bold mb-3">
                                Existing Images
                            </h5>

                            <p class="text-muted small">
                                Select the images you want to delete.
                            </p>

                            <div class="row">

                                <% campground.images.forEach(function(img, i) { %>

                                    <div class="col-6 col-md-4 mb-4">

                                        <div class="card h-100 shadow-sm">

                                            <img
                                                src="<%= img.thumbnail %>"
                                                class="card-img-top"
                                                alt="Campground image"
                                                style="height: 150px; object-fit: cover;">

                                            <div class="card-body p-2 text-center">

                                                <div class="custom-control custom-checkbox">
                                                    <input
                                                        type="checkbox"
                                                        class="custom-control-input"
                                                        name="deleteImages[]"
                                                        id="image-<%= i %>"
                                                        value="<%= img.filename %>">

                                                    <label
                                                        class="custom-control-label text-danger small"
                                                        for="image-<%= i %>">
                                                        Delete image
                                                    </label>
                                                </div>

                                            </div>

                                        </div>

                                    </div>

                                <% }) %>

                            </div>

                        <% } %>


                        <!-- SUBMIT -->
                        <hr class="my-4">

                        <button
                            class="btn btn-warning btn-lg btn-block font-weight-bold"
                            type="submit">

                            <i class="fas fa-save mr-2"></i>
                            Update Campground

                        </button>

                        <a
                            href="/campgrounds/<%= campground._id %>"
                            class="btn btn-outline-secondary btn-block mt-3">

                            Cancel and Go Back

                        </a>

                    </form>

                </div>
            </div>

            <p class="text-center text-muted small mt-4">
                YelpCamp &mdash; Make every adventure memorable.
            </p>

        </div>
    </div>

</div>