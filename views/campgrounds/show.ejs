<% layout('layout/boilerplate') %>

<link rel="stylesheet" href="/stylesheets/stars.css">

<div class="container py-4">

    <!-- CAMPGROUND HEADER -->
    <div class="mb-4">
        <a href="/campgrounds" class="text-muted">
            <i class="fas fa-arrow-left mr-2"></i>
            Back to Campgrounds
        </a>

        <h1 class="font-weight-bold mt-3 mb-2">
            <%= campground.title %>
        </h1>

        <p class="text-muted mb-0">
            <i class="fas fa-map-marker-alt text-danger mr-2"></i>
            <%= campground.location %>
        </p>
    </div>


    <div class="row">

        <!-- LEFT COLUMN -->
        <div class="col-lg-7 mb-4">

            <!-- IMAGE CAROUSEL -->
            <div class="card border-0 shadow-sm mb-4">

                <% if (campground.images && campground.images.length > 0) { %>

                    <div id="campgroundCarousel" class="carousel slide"
                        data-ride="carousel">

                        <div class="carousel-inner">

                            <% campground.images.forEach((img, i) => { %>

                                <div class="carousel-item <%= i === 0 ? 'active' : '' %>">

                                    <img
                                        src="<%= img.url %>"
                                        class="d-block w-100"
                                        alt="<%= campground.title %>"
                                        style="height: 400px; object-fit: cover;">

                                </div>

                            <% }) %>

                        </div>

                        <% if (campground.images.length > 1) { %>

                            <a class="carousel-control-prev"
                                href="#campgroundCarousel"
                                role="button"
                                data-slide="prev">

                                <span class="carousel-control-prev-icon"
                                    aria-hidden="true"></span>

                                <span class="sr-only">Previous</span>

                            </a>

                            <a class="carousel-control-next"
                                href="#campgroundCarousel"
                                role="button"
                                data-slide="next">

                                <span class="carousel-control-next-icon"
                                    aria-hidden="true"></span>

                                <span class="sr-only">Next</span>

                            </a>

                        <% } %>

                    </div>

                <% } else { %>

                    <img
                        src="https://res.cloudinary.com/kjcxoa9y/image/upload/v1793429783/YelpCamp/rzscswqklixzbeif44t5.png"
                        class="card-img-top"
                        alt="Campground"
                        style="height: 350px; object-fit: cover;">

                <% } %>

            </div>


            <!-- CAMPGROUND DETAILS -->
            <div class="card border-0 shadow-sm mb-4">

                <div class="card-body p-4">

                    <div class="d-flex justify-content-between align-items-center mb-3">

                        <h4 class="font-weight-bold mb-0">
                            About this campground
                        </h4>

                        <span class="badge badge-success p-2">
                            <i class="fas fa-campground mr-1"></i>
                            Campground
                        </span>

                    </div>

                    <p class="text-muted" style="line-height: 1.8;">
                        <%= campground.description %>
                    </p>

                    <hr>

                    <div class="row">

                        <div class="col-sm-6 mb-3">

                            <small class="text-muted d-block mb-1">
                                LOCATION
                            </small>

                            <strong>
                                <i class="fas fa-map-marker-alt text-danger mr-2"></i>
                                <%= campground.location %>
                            </strong>

                        </div>

                        <div class="col-sm-6 mb-3">

                            <small class="text-muted d-block mb-1">
                                PRICE PER NIGHT
                            </small>

                            <strong class="text-success">
                                $<%= campground.price %>
                            </strong>

                        </div>

                        <div class="col-sm-6">

                            <small class="text-muted d-block mb-1">
                                SUBMITTED BY
                            </small>

                            <strong>
                                <i class="fas fa-user-circle mr-2"></i>
                                <%= campground.author.username %>
                            </strong>

                        </div>

                    </div>

                </div>


                <!-- OWNER ACTIONS -->
                <% if (currentUser && campground.author.equals(currentUser._id)) { %>

                    <div class="card-footer bg-white p-3">

                        <div class="d-flex">

                            <a
                                href="/campgrounds/<%= campground._id %>/edit"
                                class="btn btn-outline-primary mr-2">

                                <i class="fas fa-edit mr-1"></i>
                                Edit

                            </a>

                            <form
                                class="d-inline"
                                action="/campgrounds/<%= campground._id %>?_method=DELETE"
                                method="POST">

                                <button type="submit" class="btn btn-outline-danger">

                                    <i class="fas fa-trash-alt mr-1"></i>
                                    Delete

                                </button>

                            </form>

                        </div>

                    </div>

                <% } %>

            </div>


            <!-- LOCATION MAP -->
            <div class="card border-0 shadow-sm">

                <div class="card-header bg-white py-3">
                    <h5 class="font-weight-bold mb-0">
                        <i class="fas fa-map-marked-alt mr-2 text-success"></i>
                        Find This Campground
                    </h5>
                </div>

                <div class="card-body p-0">

                    <div
                        class="map"
                        id="map"
                        style="width: 100%; height: 350px;">
                    </div>

                </div>

            </div>

        </div>


        <!-- RIGHT COLUMN -->
        <div class="col-lg-5">

            <!-- REVIEW FORM -->
            <% if (currentUser) { %>

                <div class="card border-0 shadow-sm mb-4">

                    <div class="card-body p-4">

                        <h4 class="font-weight-bold mb-2">
                            Write a Review
                        </h4>

                        <p class="text-muted small">
                            Share your experience with other campers.
                        </p>

                        <hr>

                        <form
                            action="/campgrounds/<%= campground._id %>/reviews"
                            method="POST"
                            class="mb-0 validated-form">

                            <div class="form-group">

                                <label class="font-weight-bold">
                                    Your Rating
                                </label>

                                <fieldset class="starability-basic">

                                    <input
                                        type="radio"
                                        id="no-rate"
                                        class="input-no-rate"
                                        name="review[rating]"
                                        value="0"
                                        checked
                                        aria-label="No rating." />

                                    <input
                                        type="radio"
                                        id="first-rate1"
                                        name="review[rating]"
                                        value="1" />

                                    <label for="first-rate1"
                                        title="Terrible">1 star</label>

                                    <input
                                        type="radio"
                                        id="first-rate2"
                                        name="review[rating]"
                                        value="2" />

                                    <label for="first-rate2"
                                        title="Not good">2 stars</label>

                                    <input
                                        type="radio"
                                        id="first-rate3"
                                        name="review[rating]"
                                        value="3" />

                                    <label for="first-rate3"
                                        title="Average">3 stars</label>

                                    <input
                                        type="radio"
                                        id="first-rate4"
                                        name="review[rating]"
                                        value="4" />

                                    <label for="first-rate4"
                                        title="Very good">4 stars</label>

                                    <input
                                        type="radio"
                                        id="first-rate5"
                                        name="review[rating]"
                                        value="5" />

                                    <label for="first-rate5"
                                        title="Amazing">5 stars</label>

                                </fieldset>

                            </div>


                            <div class="form-group">

                                <label for="body" class="font-weight-bold">
                                    Your Review
                                </label>

                                <textarea
                                    class="form-control"
                                    name="review[body]"
                                    id="body"
                                    rows="5"
                                    placeholder="How was your experience?"
                                    required></textarea>

                                <div class="invalid-feedback">
                                    Please write your review.
                                </div>

                            </div>


                            <button type="submit"
                                class="btn btn-warning btn-block font-weight-bold">

                                <i class="fas fa-paper-plane mr-2"></i>
                                Submit Review

                            </button>

                        </form>

                    </div>

                </div>

            <% } else { %>

                <div class="alert alert-light border shadow-sm mb-4">

                    <h5 class="font-weight-bold">
                        Enjoyed this campground?
                    </h5>

                    <p class="text-muted mb-3">
                        Login to share your experience and leave a review.
                    </p>

                    <a href="/login" class="btn btn-warning">
                        Login to Review
                    </a>

                </div>

            <% } %>


            <!-- REVIEWS SECTION -->
            <div class="card border-0 shadow-sm">

                <div class="card-header bg-white py-3">

                    <h4 class="font-weight-bold mb-0">
                        <i class="fas fa-comments mr-2 text-success"></i>
                        Camper Reviews

                        <span class="badge badge-secondary badge-pill ml-1">
                            <%= campground.reviews.length %>
                        </span>

                    </h4>

                </div>


                <div class="card-body p-3">

                    <% if (campground.reviews.length > 0) { %>

                        <% for (let review of campground.reviews) { %>

                            <div class="border-bottom pb-3 mb-3">

                                <div class="d-flex justify-content-between align-items-center">

                                    <h6 class="font-weight-bold mb-1">
                                        <i class="fas fa-user-circle text-secondary mr-2"></i>
                                        <%= review.author.username %>
                                    </h6>

                                </div>


                                <!-- STAR RATING -->
                                <p class="starability-result mb-2"
                                    data-rating="<%= review.rating %>">

                                    Rated: <%= review.rating %> stars

                                </p>


                                <!-- REVIEW TEXT -->
                                <p class="text-muted mb-2"
                                    style="line-height: 1.7;">

                                    <%= review.body %>

                                </p>


                                <!-- REVIEW OWNER DELETE -->
                                <% if (currentUser && review.author.equals(currentUser._id)) { %>

                                    <form
                                        action="/campgrounds/<%= campground._id %>/reviews/<%= review._id %>?_method=DELETE"
                                        method="POST">

                                        <button
                                            type="submit"
                                            class="btn btn-sm btn-outline-danger">

                                            <i class="fas fa-trash-alt mr-1"></i>
                                            Delete Review

                                        </button>

                                    </form>

                                <% } %>

                            </div>

                        <% } %>

                    <% } else { %>

                        <div class="text-center py-4">

                            <i class="fas fa-comment-slash fa-3x text-muted mb-3"></i>

                            <h5 class="font-weight-bold">
                                No Reviews Yet
                            </h5>

                            <p class="text-muted mb-0">
                                Be the first to share your experience!
                            </p>

                        </div>

                    <% } %>

                </div>

            </div>

        </div>

    </div>

</div>


<!-- MAPBOX DATA -->
<script>
    const mapToken = '<%= process.env.MAPBOX_TOKEN %>';
    const campground = <%- JSON.stringify(campground) %>;
</script>

<script src="/javascripts/showPageMap.js"></script>